{
  "name": "gloamtide",
  "private": true,
  "version": "0.1.0",
  "description": "A first-person roguelike about crossing an island with magic made of sentences.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playtest": "vite build && node tools/playtest.cjs",
    "assets": "python3 tools/fetch-assets.py"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "5.1.0",
    "@fontsource/grenze-gotisch": "5.1.0",
    "three": "0.170.0",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
